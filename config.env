# Domain / IP
DOMAIN="${DOMAIN:-$(curl -s ifconfig.me)}"   # Auto‑detect public IP if no domain

# Deployment user (non‑root)
DEPLOY_USER="vpsadmin"
DEPLOY_USER_HOME="/home/$DEPLOY_USER"

# Application repositories
LARAVEL_REPO="https://github.com/your-username/vps-manager-backend.git"
AGENT_REPO="https://github.com/your-username/vps-manager-agent.git"
FRONTEND_REPO="https://github.com/your-username/vps-manager-frontend.git"

# MySQL root password (will be auto‑generated if empty)
MYSQL_ROOT_PASSWORD="${MYSQL_ROOT_PASSWORD:-$(openssl rand -base64 24)}"

# Laravel .env settings
APP_ENV="production"
APP_DEBUG="false"
APP_URL="http://$DOMAIN"
ADMIN_EMAIL="admin@$DOMAIN"
ADMIN_PASSWORD="$(openssl rand -base64 16)"

# Node.js agent settings
AGENT_PORT="3001"
AGENT_API_KEY="$(openssl rand -base64 32)"

# Paths
LARAVEL_PATH="$DEPLOY_USER_HOME/vps-backend"
AGENT_PATH="$DEPLOY_USER_HOME/vps-agent"
NGINX_SITE_CONF="/etc/nginx/sites-available/vps-manager"
NGINX_SITE_ENABLED="/etc/nginx/sites-enabled/vps-manager"